;; Non-executing preparation fixture. Every lifecycle function traps if invoked.
(component
  (core module $code
    (memory (export "memory") 1)
    (func (export "activate") (result i32) unreachable)
    (func (export "execute") (param i32 i32 i32 i32) (result i32) unreachable)
    (func (export "deactivate") (result i32) unreachable)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) unreachable)
  )
  (core instance $code (instantiate $code))
  (alias core export $code "memory" (core memory $memory))
  (alias core export $code "activate" (core func $activate))
  (alias core export $code "execute" (core func $execute))
  (alias core export $code "deactivate" (core func $deactivate))
  (alias core export $code "realloc" (core func $realloc))
  (type $strings (list string))
  (type $activation (result $strings (error string)))
  (type $execution (result string (error string)))
  (type $deactivation (result (error string)))
  (func $activate (result $activation)
    (canon lift (core func $activate) (memory $memory)))
  (func $execute (param "command" string) (param "input" string) (result $execution)
    (canon lift (core func $execute) (memory $memory) (realloc $realloc)))
  (func $deactivate (result $deactivation)
    (canon lift (core func $deactivate) (memory $memory)))
  (instance $lifecycle
    (export "activate" (func $activate))
    (export "execute" (func $execute))
    (export "deactivate" (func $deactivate)))
  (export "maghemite:modules-sync/lifecycle@0.1.0" (instance $lifecycle))
)
